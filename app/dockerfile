FROM python:3.11-slim

WORKDIR /app

RUN apt-get update && \
    apt-get install -y gcc python3-dev libpq-dev curl && \
    rm -rf /var/lib/apt/lists/* && \
    mkdir -p /tmp/flask_session && \
    chmod 777 /tmp/flask_session

COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt gunicorn

COPY . .

ENV PYTHONUNBUFFERED=1
ENV FLASK_APP=app.py
ENV FLASK_ENV=production
ENV FLASK_DEBUG=0
ENV GUNICORN_CMD_ARGS="--timeout 120 --workers 4 --bind 0.0.0.0:7070 --log-level info --error-logfile /var/log/gunicorn-error.log --access-logfile /var/log/gunicorn-access.log --capture-output --enable-stdio-inheritance"

EXPOSE 7070

HEALTHCHECK --interval=30s --timeout=10s --start-period=30s --retries=3 \
    CMD curl -f http://localhost:7070/health || exit 1

COPY start.sh /start.sh
RUN chmod +x /start.sh

CMD ["/start.sh"]